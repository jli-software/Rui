{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rui",
  "version": "0.5.4",
  "identifier": "ch.gaiching.rui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rui",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 300,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Schlanker Texteditor",
    "longDescription": "Rui ist ein schlanker Texteditor für Code-Snippets und einfache Textbearbeitung, mit Zeilennummern, Syntax-Highlighting und einer Befehlspalette statt einer Menüleiste.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "md",
          "markdown",
          "mdown",
          "mkd",
          "log",
          "out",
          "err",
          "trace",
          "nfo",
          "csv",
          "tsv",
          "conf",
          "cfg",
          "ini",
          "properties",
          "env"
        ],
        "name": "Textdatei",
        "description": "Textdatei",
        "role": "Editor"
      },
      {
        "ext": ["ps1", "psm1", "psd1", "sh", "bash", "zsh", "fish", "py", "pyw", "pyi"],
        "name": "Script",
        "description": "Script",
        "role": "Editor"
      },
      {
        "ext": [
          "rs",
          "go",
          "cs",
          "csx",
          "js",
          "mjs",
          "cjs",
          "ts",
          "jsx",
          "tsx",
          "sql",
          "toml",
          "yaml",
          "yml",
          "json",
          "jsonc",
          "xml",
          "xaml",
          "diff",
          "patch"
        ],
        "name": "Quelltext",
        "description": "Quelltext",
        "role": "Editor"
      }
    ]
  }
}
