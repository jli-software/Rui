{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rui",
  "version": "0.1.1",
  "identifier": "ch.gaiching.rui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rui",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 300,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Schlanker Texteditor",
    "longDescription": "Rui ist ein schlanker Texteditor für Code-Snippets und einfache Textbearbeitung, mit Zeilennummern, Syntax-Highlighting und einer Befehlspalette statt einer Menüleiste.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "md", "markdown", "log", "conf", "ini", "csv"],
        "name": "Textdatei",
        "description": "Textdatei",
        "role": "Editor"
      }
    ]
  }
}
